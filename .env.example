# Local development only — these credentials match docker-compose.yml and are
# not secret. Copy to .env to get started:  cp .env.example .env

# The API connects as the restricted role. It owns no tables, so Row-Level
# Security policies apply to every query it makes.
DATABASE_URL="postgresql://pulse_app:pulse_app_pw@localhost:5433/pulse?schema=public"

# Prisma CLI only (migrate/generate). Owns the schema; never used at runtime.
MIGRATION_DATABASE_URL="postgresql://pulse_owner:pulse_owner_pw@localhost:5433/pulse?schema=public"

# Host port the Postgres container publishes on (see docker-compose.yml).
POSTGRES_HOST_PORT=5433

# Signs the local login tokens. Generate your own: openssl rand -base64 48
# There is no fallback — the API refuses to start without it.
JWT_SECRET="+Ke2p0lOwHSSjWPiot3eoyaDez7/tNAtwVvb3jrjvShnSQJ/LdjQbqlm3Sqg1W2e"

# POST /auth/login issues a valid token for any seeded email with NO password.
# Off unless this is exactly "true"; setting it with NODE_ENV=production
# refuses to start.
ENABLE_DEV_LOGIN=true

PORT=3000
WEB_ORIGIN="http://localhost:5173"
