// Tenant isolation is enforced by PostgreSQL row-level security, which Prisma
// does not model. The policies, CHECK constraints, grants and helper functions
// live in hand-written SQL inside the migration that creates these tables —
// see prisma/migrations/*/migration.sql. Prisma is not the source of truth for
// security here; the migration is.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  manager
  member

  @@map("role")
}

enum SurveyStatus {
  draft
  active
  archived

  @@map("survey_status")
}

enum QuestionType {
  rating
  yes_no

  @@map("question_type")
}

model Organization {
  id      String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name    String
  logoUrl String? @map("logo_url")

  users     User[]
  surveys   Survey[]
  questions Question[]
  responses Response[]
  answers   Answer[]

  @@map("organizations")
}

model User {
  id    String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId String @map("org_id") @db.Uuid
  email String @unique
  name  String
  role  Role

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  authored  Survey[]     @relation("SurveyCreator")
  responses Response[]

  // Target of the composite foreign keys that pin a child row to its parent's org.
  @@unique([id, orgId])
  @@map("users")
}

model Survey {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orgId     String       @map("org_id") @db.Uuid
  title     String
  status    SurveyStatus @default(draft)
  createdBy String       @map("created_by") @db.Uuid

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  creator   User         @relation("SurveyCreator", fields: [createdBy, orgId], references: [id, orgId])
  questions Question[]
  responses Response[]

  @@unique([id, orgId])
  @@map("surveys")
}

model Question {
  id       String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId String       @map("survey_id") @db.Uuid
  orgId    String       @map("org_id") @db.Uuid
  text     String
  type     QuestionType
  position Int          @db.SmallInt

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  survey  Survey       @relation(fields: [surveyId, orgId], references: [id, orgId], onDelete: Cascade)
  answers Answer[]

  // position is CHECKed to 1..3 in the migration; with this unique that caps a
  // survey at three questions structurally, with no counting in the service.
  @@unique([surveyId, position])
  // Target of the answers FK that pins an answer's value column to the question type.
  @@unique([id, type])
  @@map("questions")
}

model Response {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  surveyId    String   @map("survey_id") @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  orgId       String   @map("org_id") @db.Uuid
  weekStart   DateTime @map("week_start") @db.Date
  submittedAt DateTime @default(now()) @map("submitted_at") @db.Timestamptz(3)

  org     Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  survey  Survey       @relation(fields: [surveyId, orgId], references: [id, orgId], onDelete: Cascade)
  user    User         @relation(fields: [userId, orgId], references: [id, orgId], onDelete: Cascade)
  answers Answer[]

  // One response per member, per survey, per week — as a constraint, not a check-then-insert.
  @@unique([surveyId, userId, weekStart])
  @@unique([id, orgId])
  @@map("responses")
}

model Answer {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  responseId   String       @map("response_id") @db.Uuid
  questionId   String       @map("question_id") @db.Uuid
  orgId        String       @map("org_id") @db.Uuid
  questionType QuestionType @map("question_type")
  ratingValue  Int?         @map("rating_value") @db.SmallInt
  boolValue    Boolean?     @map("bool_value")

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  response Response     @relation(fields: [responseId, orgId], references: [id, orgId], onDelete: Cascade)
  question Question     @relation(fields: [questionId, questionType], references: [id, type])

  @@unique([responseId, questionId])
  @@map("answers")
}
